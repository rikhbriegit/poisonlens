# Ollama Cloud API key — https://ollama.com/settings/keys
# Never commit the real key. Copy this file to .env.local and fill it in.
OLLAMA_API_KEY=

# Default model. gpt-oss:20b-cloud is the smallest model in the cloud catalogue
# and the closest stand-in for a model running on the NAS itself.
OLLAMA_MODEL=gpt-oss:20b-cloud
